{
  "expo": {
    "name": "SongBookApp",
    "slug": "SongBookApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/music-note.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.cipherwizard31.SongBookApp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "b7fabb99-7df6-41b4-990d-0506a22efeee"
      }
    },
    "plugins": [
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Selah Kignit to access your microphone for recording audio memos."
        }
      ]
    ]
  }
}
